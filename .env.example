NEXT_PUBLIC_AUDIO_API_URL=http://localhost:8000
NEXT_PUBLIC_AUDIO_MAX_UPLOAD_BYTES=4000000

# Phase FS1 full-song worker (demucs + whisper). This feature is optional and
# off by default: pointing it at an empty string keeps the Full-Song panel
# disabled (it will surface a "worker unreachable" notice instead).
NEXT_PUBLIC_FS1_API_URL=http://localhost:8088
# Optional override for the accepted upload size (default 25 MB).
NEXT_PUBLIC_FS1_MAX_UPLOAD_BYTES=26214400
