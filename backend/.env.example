APP_NAME=SwarAI Audio Analysis
ANALYSIS_VERSION=3.0.0
MELODY_ANALYSIS_VERSION=3.1.0
MAX_UPLOAD_BYTES=4000000
MAX_DURATION_SECONDS=300
ANALYSIS_SAMPLE_RATE=22050
MELODY_MIN_FREQUENCY=65.406391
MELODY_MAX_FREQUENCY=2093.004522
MELODY_MIN_NOTE_DURATION_SECONDS=0.08
MELODY_MERGE_GAP_SECONDS=0.06
MELODY_MIN_VOICED_PROBABILITY=0.5
MELODY_MIN_RMS=0.005
MELODY_HOP_LENGTH=256
MELODY_FRAME_LENGTH=2048
TEMP_ROOT=backend/.runtime
FFMPEG_BINARY=ffmpeg
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Reflect a phone/tablet on the same Wi-Fi reaching the API (e.g. Origin
# http://192.168.x.x:3001). Only literal private/link-local IPs on a dev port
# are ever reflected; public origins are never reflected. Keep true for local
# development. Set to false in production so the API trusts ONLY the explicit
# CORS_ORIGINS above and never arbitrary LAN origins.
CORS_REFLECT_LAN=true
TRANSCRIPTION_ENGINE=auto
BASIC_PITCH_ENABLED=false

# Phase 6A AI providers. Keep these values only in the backend environment.
GEMINI_API_KEY=
GROQ_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.1-8b-instant
AI_REQUEST_TIMEOUT_SECONDS=15
AI_RETRY_LIMIT=1
AI_PROVIDER_PRIORITY=gemini,groq,mock
AI_MAX_PROMPT_CHARS=4000
AI_MAX_RESPONSE_CHARS=4000
AI_MAX_RESPONSE_BYTES=65536
AI_MAX_OUTPUT_TOKENS=512
AI_MOCK_FALLBACK_ENABLED=true

# Phase 6E safety guards for the AI tutor endpoints.
AI_RATE_LIMIT_PER_MINUTE=12
AI_DUPLICATE_WINDOW_SECONDS=4
